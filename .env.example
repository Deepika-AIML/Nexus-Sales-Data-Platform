# =============================================================================
# Nexus environment configuration
# Copy this file to `.env` in the project root before running
# `docker compose up --build`. Never commit the real `.env` file — it stays
# out of git via .gitignore.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development
# Maximum accepted CSV upload size, in megabytes.
UPLOAD_MAX_MB=25
# Comma-separated list of origins the backend accepts CORS requests from.
# Must include the URL the frontend is actually served on.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- MySQL ---------------------------------------------------------------------
# Root password used only to initialize the MySQL container itself.
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=nexus
MYSQL_USER=nexus
MYSQL_PASSWORD=change_me_app_password
# Inside docker-compose's network, the MySQL service is reachable by its
# service name — leave this as `mysql` unless you changed the service name.
MYSQL_HOST=mysql
MYSQL_PORT=3306

# --- Spark ---------------------------------------------------------------------
# local[*] uses all available cores inside the backend container. Point this
# at a real cluster master (e.g. spark://host:7077) if you scale Nexus
# beyond a single machine later (see docs/TECHNICAL_LEARNING_GUIDE.md).
SPARK_MASTER=local[*]
