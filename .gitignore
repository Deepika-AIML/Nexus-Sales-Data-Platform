# --- Environment / secrets ---------------------------------------------------
.env

# --- Python --------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.venv/
venv/

# --- Data / pipeline outputs (regenerated by processing; never source-controlled) ---
data/bronze/*
data/silver/*
data/gold/*
data/rejected/*
data/outputs/*
!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep
!data/rejected/.gitkeep
!data/outputs/.gitkeep
# The raw/ folder is where uploaded source files land — also not committed,
# except the bundled Superstore reference dataset used for local testing.
data/raw/*
!data/raw/.gitkeep
!data/raw/Sample_-_Superstore.csv

# --- Docker / Spark ---------------------------------------------------------------
*.log

# --- OS / editor ---------------------------------------------------------------------
.DS_Store
.idea/
.vscode/

# --- Generated test data (regenerated by scripts/generate_test_variants.py) ---
scripts/test_data/
scripts/perf_data/
